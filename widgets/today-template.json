{
  "type": "AdaptiveCard",
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "version": "1.5",
  "body": [
    { "type": "TextBlock", "text": "${date}", "weight": "Bolder", "size": "Medium" },
    { "type": "TextBlock", "text": "${summary}", "isSubtle": true, "spacing": "None" },
    {
      "type": "Container", "spacing": "Medium",
      "items": [
        { "$data": "${tasks}", "type": "ColumnSet", "columns": [
          { "type": "Column", "width": "stretch", "items": [{ "type": "TextBlock", "text": "• ${title}", "wrap": false }] },
          { "type": "Column", "width": "auto", "items": [{ "type": "TextBlock", "text": "${when}", "isSubtle": true }] }
        ] }
      ]
    },
    {
      "type": "Container", "spacing": "Medium",
      "items": [
        { "$data": "${habits}", "type": "TextBlock", "text": "${if(done, '✅', '⬜')} ${name}", "spacing": "Small" }
      ]
    }
  ],
  "actions": [
    { "type": "Action.Execute", "title": "Open", "verb": "open" }
  ]
}
